@article{jenni2026childpenalty,
  title={Child Penalty in the Extended Family},
  author={Jenni, Alexandre and Stuhler, Jan and Zweim{\"u}ller, Josef},
  abstract={We use administrative data from Switzerland to study how gender attitudes are transmitted and sorted on within the family. Constructing extensive kinship networks through iterative linking of spouses and siblings, we first show that individual "child penalties" correlate across 53 types of kin, with correlations that decay only slowly with kinship distance. A model in which latent gender attitudes are transmitted within families and sorted on in the marriage market reproduces these patterns, and implies three main findings. First, child penalties are noisy expressions of the underlying attitudes, so that observed kinship correlations vastly understate family similarity: we estimate a sibling correlation in latent attitudes of about 0.7, far above the corresponding correlation in penalties (0.18) and above benchmark estimates based on observed attitude measures. Second, a high spousal correlation (about 0.8) in latent attitudes is required to explain the slow decay of correlations with kinship distance - to our knowledge the first quantification of assortative mating on gender attitudes, and stronger than documented sorting on education or earnings. Third, comparing kinship chains that run through siblings of different genders, we find that transmission operates as strongly through sons as through daughters, even though men themselves experience negligible penalties. Survey data on stated gender attitudes for a subsample corroborate the latent-factor interpretation. Strong family transmission and spousal sorting imply that gender attitudes reproduce within family lines, contributing to the persistence and polarization of gender norms.},
}

